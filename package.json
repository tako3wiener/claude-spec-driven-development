{
  "name": "claude-spec-driven-development",
  "version": "5.4.0",
  "private": true,
  "description": "Install SDD independently, then select a local or Dev Container Java Git repository",
  "bin": {
    "sdd-install": "bin/sdd-install.js",
    "sdd-uninstall": "bin/sdd-uninstall.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "install.py",
    "install.sh",
    "CLAUDE.md",
    ".claude/agents/",
    ".claude/skills/",
    ".claude/settings.json",
    "scripts/",
    "templates/",
    "docs/ai/",
    "examples/playwright-java/",
    "installer-gitignore.txt",
    "README.md",
    "uninstall.sh",
    "standalone.py",
    "sdd",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/.pytest_cache/**",
    "!**/target/**",
    "!**/build/**",
    "!**/*.pem",
    "!**/*.key",
    "!**/*.sig"
  ]
}
